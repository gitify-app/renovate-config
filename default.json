{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Default preset for use with gitify's repos",
  "extends": [
    "config:best-practices",
    ":enableVulnerabilityAlerts",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScope(deps)",
    ":separateMultipleMajorReleases",
    ":rebaseStalePrs",
    "schedule:weekly",
    "group:vitePlus",
    "group:githubArtifactActions",
    "customManagers:biomeVersions",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "osvVulnerabilityAlerts": true,
  "labels": ["dependency"],
  "packageRules": [
    {
      "description": "Pin npm dependency ranges by default",
      "matchManagers": ["npm"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Keep engine ranges (for example node) as ranges rather than pinning them",
      "matchDepTypes": ["engines"],
      "rangeStrategy": "auto"
    },
    {
      "description": "Use the dependency name in npm commit messages and PR titles",
      "matchDatasources": ["npm"],
      "commitMessageTopic": "{{depName}}"
    },
    {
      "description": "Group Node.js runtime updates across Docker images, nvm, nodenv, asdf, mise, engines, and devEngines",
      "matchDatasources": ["docker", "node-version"],
      "matchPackageNames": ["/(?:^|/)node$/"],
      "groupName": "node",
      "commitMessageTopic": "Node.js"
    },
    {
      "description": "Group @types/node updates with the Node.js runtime",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@types/node"],
      "groupName": "node",
      "commitMessageTopic": "Node.js"
    },
    {
      "description": "Auto-merge digest updates for gitify-app/renovate-config workflows",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["gitify-app/renovate-config"],
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "platformAutomerge": false
    }
  ]
}
